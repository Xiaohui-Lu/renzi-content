    {"text": "快点吃", "cantonese": "快啲食", "jyutping": "faai3 di1 sik6", "group": "句子"},
    {"text": "慢慢吃", "cantonese": "慢慢食", "jyutping": "maan6 maan2 sik6", "group": "句子"},
    {"text": "小心点", "cantonese": "小心啲", "jyutping": "siu2 sam1 di1", "group": "句子"},
    {"text": "不要跑", "cantonese": "唔好走", "jyutping": "m4 hou2 zau2", "group": "句子"},
    {"text": "不要哭", "cantonese": "唔好喊", "jyutping": "m4 hou2 haam3", "group": "句子"},
    {"text": "别怕", "cantonese": "唔使驚", "jyutping": "m4 sai2 geng1", "group": "句子"},
    {"text": "没事", "cantonese": "冇事", "jyutping": "mou5 si6", "group": "句子"},
    {"text": "真的吗？", "cantonese": "真係咩？", "jyutping": "zan1 hai6 me1", "group": "句子"},
    {"text": "我知道了", "cantonese": "我知道喇", "jyutping": "ngo5 zi1 dou3 laa3", "group": "句子"},
    {"text": "我听不懂", "cantonese": "我聽唔明", "jyutping": "ngo5 teng1 m4 ming4", "group": "句子"},
    {"text": "再说一次", "cantonese": "講多次", "jyutping": "gong2 do1 ci3", "group": "句子"},
    {"text": "你说什么？", "cantonese": "你講乜嘢呀？", "jyutping": "nei5 gong2 mat1 je5 aa3", "group": "句子"},
    {"text": "请喝茶", "cantonese": "請飲茶", "jyutping": "ceng2 jam2 caa4", "group": "句子"},
    {"text": "外婆好", "cantonese": "婆婆好", "jyutping": "po4 po2 hou2", "group": "句子"},
    {"text": "外公早上好", "cantonese": "公公早晨", "jyutping": "gung4 gung1 zou2 san4", "group": "句子"},
    {"text": "谢谢外婆", "cantonese": "多謝婆婆", "jyutping": "do1 ze6 po4 po2", "group": "句子"},
    {"text": "我想打电话给外婆", "cantonese": "我想打電話畀婆婆", "jyutping": "ngo5 soeng2 daa2 din6 waa2 bei2 po4 po2", "group": "句子"},
    {"text": "你住在哪里？", "cantonese": "你住喺邊度呀？", "jyutping": "nei5 zyu6 hai2 bin1 dou6 aa3", "group": "句子"},
    {"text": "一起吃饭吧", "cantonese": "一齊食飯啦", "jyutping": "jat1 cai4 sik6 faan6 laa1", "group": "句子"},
    {"text": "好吃吗？", "cantonese": "好唔好食呀？", "jyutping": "hou2 m4 hou2 sik6 aa3", "group": "句子"},
    {"text": "很香", "cantonese": "好香", "jyutping": "hou2 hoeng1", "group": "句子"},
    {"text": "很臭", "cantonese": "好臭", "jyutping": "hou2 cau3", "group": "句子"},
    {"text": "你看！", "cantonese": "你睇！", "jyutping": "nei5 tai2", "group": "句子"},
    {"text": "这是我的", "cantonese": "呢個係我嘅", "jyutping": "ni1 go3 hai6 ngo5 ge3", "group": "句子"},
    {"text": "那是你的", "cantonese": "嗰個係你嘅", "jyutping": "go2 go3 hai6 nei5 ge3", "group": "句子"},
    {"text": "我们是好朋友", "cantonese": "我哋係好朋友", "jyutping": "ngo5 dei6 hai6 hou2 pang4 jau5", "group": "句子"},
    {"text": "新年快乐", "cantonese": "新年快樂", "jyutping": "san1 nin4 faai3 lok6", "group": "句子"}
  ]
}
